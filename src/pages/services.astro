---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, faqs } from '../data/site';

const steps = [
  { n: '01', title: 'Discovery call', text: 'A free 30-minute conversation about your business, your goals and what’s getting in the way.' },
  { n: '02', title: 'Recommendation', text: 'If we’re a fit, you’ll receive a short proposal with the right engagement, scope and investment.' },
  { n: '03', title: 'Kick-off', text: 'We begin with the Survey phase — so from week one, you’re working on the right things.' },
];
---
<Base title="Services" description={services.lead}>
  <section class="page-hero grid-bg">
    <div class="container">
      <p class="eyebrow">{services.eyebrow}</p>
      <h1>{services.title}</h1>
      <p class="lead">{services.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="services-grid">
        {services.items.map((s, i) => <ServiceCard {...s} index={i} headingLevel="h2" />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <p class="eyebrow" data-reveal>How it starts</p>
      <ol class="steps">
        {steps.map((s, i) => (
          <li data-reveal style={`--delay: ${i * 90}ms`}>
            <span class="steps__n">{s.n}</span>
            <h2 class="steps__title">{s.title}</h2>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container faq">
      <div class="faq__intro" data-reveal>
        <p class="eyebrow">Questions</p>
        <h2>Frequently asked</h2>
        <p class="muted">Something else on your mind? <a href="/contact">Get in touch</a>.</p>
      </div>
      <div class="faq__list">
        {faqs.map((f) => (
          <details class="faq__item" data-reveal>
            <summary>
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <p class="muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .services-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: stretch;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .steps li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }
  .steps__n {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    color: var(--brass-text);
    line-height: 1;
  }
  .steps__title {
    font-size: var(--step-2);
  }

  .faq {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 60rem) {
    .faq {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 5rem;
    }
  }
  .faq__intro {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .faq__intro a {
    color: var(--ink);
    text-decoration-color: var(--brass);
    text-underline-offset: 3px;
  }
  .faq__item {
    border-top: 1px solid var(--line-strong);
  }
  .faq__item:last-child {
    border-bottom: 1px solid var(--line-strong);
  }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--brass);
    transition: transform 0.3s var(--ease);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }
  .faq__item p {
    padding-bottom: 1.75rem;
    max-width: 40rem;
  }
</style>
