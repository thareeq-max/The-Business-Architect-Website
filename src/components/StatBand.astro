---
import { stats } from '../data/site';
---
<section class="stats" aria-label="Results at a glance">
  <div class="container">
    <dl class="stats__grid">
      {stats.map((s, i) => (
        <div class="stat" data-reveal style={`--delay: ${i * 80}ms`}>
          <dt class="stat__label">{s.label}</dt>
          <dd class="stat__value">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats {
    border-block: 1px solid var(--line);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 52rem) {
    .stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: clamp(1.75rem, 1rem + 2.5vw, 3rem) clamp(0.75rem, 0.5rem + 1vw, 2rem);
    border-left: 1px solid var(--line);
  }
  .stat:nth-child(odd) {
    border-left: 0;
  }
  @media (max-width: 51.99rem) {
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (min-width: 52rem) {
    .stat:nth-child(odd) {
      border-left: 1px solid var(--line);
    }
    .stat:first-child {
      border-left: 0;
    }
  }
  .stat__value {
    font-family: var(--font-serif);
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat__label {
    color: var(--slate);
    font-size: 0.95rem;
  }
</style>
