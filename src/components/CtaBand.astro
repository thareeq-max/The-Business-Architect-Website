---
import { ctaBand, site } from '../data/site';
import Arrow from './Arrow.astro';
---
<section class="cta section section--dark grid-bg">
  <div class="container cta__inner" data-reveal>
    <p class="eyebrow">Next step</p>
    <h2>{ctaBand.title}</h2>
    <p class="lead">{ctaBand.text}</p>
    <div class="btn-row">
      <a href={site.bookingUrl} class="btn btn--brass" target="_blank" rel="noopener">
        {ctaBand.button} <Arrow />
      </a>
      <a href="/contact" class="btn btn--ghost-light">Send a message</a>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
  }
  .cta h2 {
    max-width: 16em;
  }
  .cta .lead {
    margin-inline: auto;
    max-width: 34em;
  }
  .btn-row {
    justify-content: center;
    margin-top: 0.75rem;
  }
</style>
