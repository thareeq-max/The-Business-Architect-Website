---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  as?: 'h1' | 'h2';
}
const { eyebrow, title, lead, align = 'start', as: Tag = 'h2' } = Astro.props;
---
<div class:list={['section-heading', `section-heading--${align}`]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class="section-heading__title">{title}</Tag>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>

<style>
  .section-heading {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
  }
  .section-heading--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }
  .section-heading--center .lead {
    margin-inline: auto;
  }
</style>
