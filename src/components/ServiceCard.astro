---
import Arrow from './Arrow.astro';
import { site } from '../data/site';

interface Props {
  name: string;
  tagline: string;
  description: string;
  includes: string[];
  price: string;
  featured?: boolean;
  compact?: boolean;
  index: number;
  headingLevel?: 'h2' | 'h3';
}
const { name, tagline, description, includes, price, featured = false, compact = false, index, headingLevel: Heading = 'h3' } = Astro.props;
---
<article class:list={['service', { 'service--featured': featured }]} data-reveal style={`--delay: ${index * 90}ms`}>
  <header class="service__head">
    <p class="service__tag">{featured ? `★ ${tagline}` : tagline}</p>
    <Heading class="service__name">{name}</Heading>
  </header>
  <p class="service__desc">{description}</p>
  {!compact && (
    <ul class="service__list">
      {includes.map((item) => <li>{item}</li>)}
    </ul>
  )}
  <footer class="service__foot">
    <p class="service__price">{price}</p>
    {compact ? (
      <a href="/services" class="text-link">Details <Arrow /></a>
    ) : (
      <a href={site.bookingUrl} class:list={['btn', featured ? 'btn--brass' : 'btn--ghost']} target="_blank" rel="noopener">
        Start with a call <Arrow />
      </a>
    )}
  </footer>
</article>

<style>
  .service {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    position: relative;
    transition: border-color 0.3s var(--ease), transform 0.4s var(--ease);
  }
  .service:hover {
    border-color: var(--line-strong);
  }
  .service--featured {
    background: var(--ink);
    color: var(--on-dark);
    border-color: var(--ink);
  }
  .service--featured:hover {
    border-color: var(--ink);
  }
  .service__head {
    display: grid;
    gap: 0.6rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .service--featured .service__head {
    border-color: var(--line-dark);
  }
  .service__tag {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass-text);
  }
  .service--featured .service__tag {
    color: var(--brass);
  }
  .service__name {
    font-size: var(--step-2);
  }
  .service__desc {
    color: var(--slate);
  }
  .service--featured .service__desc {
    color: var(--on-dark-muted);
  }
  .service__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    font-size: 0.95rem;
  }
  .service__list li {
    display: grid;
    grid-template-columns: 1rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }
  .service__list li::before {
    content: '';
    width: 0.7rem;
    height: 1px;
    background: var(--brass);
    transform: translateY(-0.3em);
  }
  .service__foot {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .service__price {
    font-family: var(--font-serif);
    font-size: var(--step-1);
  }
  .service--featured .text-link {
    color: var(--on-dark);
  }
</style>
