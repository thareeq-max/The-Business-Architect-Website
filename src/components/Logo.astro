---
interface Props {
  tone?: 'ink' | 'light';
}
const { tone = 'ink' } = Astro.props;
---
<a href="/" class:list={['logo', `logo--${tone}`]} aria-label="The Business Architect — home">
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true">
    <rect x="0.5" y="0.5" width="39" height="39" rx="3" fill="none" stroke="currentColor" stroke-opacity="0.35" />
    <path d="M8 32V8M8 32h24" stroke="var(--brass)" stroke-width="2" fill="none" />
    <path d="M8 32L30 10" stroke="currentColor" stroke-width="1" stroke-dasharray="2 2.5" fill="none" />
    <circle cx="30" cy="10" r="2.2" fill="var(--brass)" />
  </svg>
  <span class="logo__word">
    <span class="logo__the">The</span>{' '}Business Architect
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
  }
  .logo--light {
    color: var(--on-dark);
  }
  .logo__mark {
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
  }
  .logo__word {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
    font-variation-settings: 'opsz' 24;
  }
  .logo__the {
    font-style: italic;
    font-weight: 380;
  }
</style>
