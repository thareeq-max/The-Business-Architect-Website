---
// An architectural line drawing of the business "building":
// Vision (roof) · Strategy (entablature) · Structure (columns) · Systems (foundation).
const columns = [66, 146, 226, 306];
const callouts = [
  { n: '01', label: 'Vision', from: [200, 150], y: 150 },
  { n: '02', label: 'Strategy', from: [352, 212], y: 212 },
  { n: '03', label: 'Structure', from: [334, 310], y: 310 },
  { n: '04', label: 'Systems', from: [382, 452], y: 452 },
];
---
<figure class="drawing" aria-label="A line drawing of a building labelled Vision, Strategy, Structure and Systems">
  <svg viewBox="0 0 520 500" role="img" aria-hidden="true">
    <defs>
      <pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="8" class="hatch" />
      </pattern>
    </defs>

    <!-- Dimension line -->
    <g class="dim">
      <line x1="40" y1="44" x2="360" y2="44" pathLength="1" class="draw" style="--d: 1.6s" />
      <line x1="40" y1="36" x2="40" y2="52" />
      <line x1="360" y1="36" x2="360" y2="52" />
      <text x="200" y="32" text-anchor="middle" class="dim-text">DESIGNED · NOT ACCUMULATED</text>
    </g>

    <!-- Roof / pediment -->
    <polygon points="40,200 200,80 360,200" pathLength="1" class="stroke draw" style="--d: .1s" />
    <polygon points="78,190 200,100 322,190" pathLength="1" class="stroke thin draw" style="--d: .3s" />

    <!-- Entablature -->
    <rect x="40" y="200" width="320" height="24" pathLength="1" class="stroke draw" style="--d: .45s" />
    <line x1="40" y1="212" x2="360" y2="212" class="thin-line" />

    <!-- Columns -->
    {columns.map((x, i) => (
      <g style={`--d: ${0.6 + i * 0.12}s`}>
        <rect x={x - 6} y="224" width="40" height="8" pathLength="1" class="stroke draw" />
        <rect x={x} y="232" width="28" height="160" pathLength="1" class="stroke draw" />
        <line x1={x + 9} y1="236" x2={x + 9} y2="388" class="thin-line" />
        <line x1={x + 19} y1="236" x2={x + 19} y2="388" class="thin-line" />
        <rect x={x - 6} y="392" width="40" height="8" pathLength="1" class="stroke draw" />
      </g>
    ))}

    <!-- Steps & foundation -->
    <rect x="30" y="400" width="340" height="14" pathLength="1" class="stroke draw" style="--d: 1.1s" />
    <rect x="20" y="414" width="360" height="14" pathLength="1" class="stroke draw" style="--d: 1.2s" />
    <line x1="0" y1="428" x2="520" y2="428" class="ground" />
    <rect x="10" y="428" width="380" height="44" fill="url(#hatch)" class="foundation" />
    <rect x="10" y="428" width="380" height="44" pathLength="1" class="stroke draw" style="--d: 1.3s" />

    <!-- Callouts -->
    {callouts.map((c, i) => (
      <g class="callout" style={`--d: ${1.5 + i * 0.15}s`}>
        <circle cx={c.from[0]} cy={c.from[1]} r="3.5" class="dot" />
        <line x1={c.from[0]} y1={c.from[1]} x2="404" y2={c.y} class="leader" />
        <text x="412" y={c.y - 5} class="callout-n">{c.n}</text>
        <text x="412" y={c.y + 13} class="callout-label">{c.label}</text>
      </g>
    ))}
  </svg>
</figure>

<style>
  .drawing {
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .stroke {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .thin {
    stroke-width: 0.8;
    stroke-opacity: 0.6;
  }
  .thin-line {
    stroke: var(--ink);
    stroke-width: 0.6;
    stroke-opacity: 0.3;
  }
  .ground {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 6 5;
    stroke-opacity: 0.5;
  }
  .hatch {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.18;
  }
  .dim line {
    stroke: var(--brass);
    stroke-width: 1;
  }
  .dim-text {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.2em;
    fill: var(--brass-text);
  }
  .dot {
    fill: var(--brass);
  }
  .leader {
    stroke: var(--brass);
    stroke-width: 1;
  }
  .callout-n {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    fill: var(--brass-text);
  }
  .callout-label {
    font-family: var(--font-serif);
    font-size: 19px;
    fill: var(--ink);
  }

  /* Draw-in animation */
  .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.4s var(--ease) forwards;
    animation-delay: var(--d, 0s);
  }
  .callout,
  .foundation {
    opacity: 0;
    animation: fade 0.8s var(--ease) forwards;
    animation-delay: var(--d, 1.4s);
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .draw,
    .callout,
    .foundation {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
</style>
